{
  "manifest_version": 3,
  "name": "OmniSearch for Thunderbird",
  "version": "0.1.0",
  "description": "Fast, fuzzy, relevance-ranked email search powered by MiniSearch. Maintains its own index, independent of Thunderbird's Gloda.",
  "author": "CR0CKER",
  "browser_specific_settings": {
    "gecko": {
      "id": "omnisearch@thunderbird.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "scripts": [
      "lib/minisearch.js",
      "lib/engine.js",
      "lib/store.js",
      "lib/indexer.js",
      "lib/events.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "OmniSearch — search your mail",
    "default_popup": "ui/search.html",
    "default_icon": "icons/search.svg",
    "theme_icons": [
      { "light": "icons/search-dark.svg", "dark": "icons/search-light.svg", "size": 16 },
      { "light": "icons/search-dark.svg", "dark": "icons/search-light.svg", "size": 32 }
    ]
  },
  "commands": {
    "_execute_action": {
      "description": "Open OmniSearch"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/search.svg",
    "32": "icons/search.svg"
  }
}
